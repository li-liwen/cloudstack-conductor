# Copy this file to a private location outside the repository, replace every
# placeholder, and keep it mode 0600. Do not commit the resolved file.
#
# The Compose file reads these values. Generate secret files separately under
# CONDUCTOR_SECRETS_DIR; this env file must not contain the secret values.

# --- Image and public names -------------------------------------------------
CONDUCTOR_IMAGE=cloudstack-conductor@sha256:REPLACE_WITH_TESTED_DIGEST
CONDUCTOR_EMBEDDINGS_IMAGE=cloudstack-conductor-embeddings@sha256:REPLACE_WITH_TESTED_DIGEST
CONDUCTOR_BIND_ADDRESS=127.0.0.1
CONDUCTOR_CLOUD_ID=replace-with-cloud-id
CONDUCTOR_PUBLIC_BASE_URL=https://portal.example.com
MCP_PUBLIC_URL=https://mcp.example.com
OIDC_ISSUER=https://auth.example.com/application/o/cloudstack-conductor/
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_PROVIDER_NAME=Example-SSO
OPENWEBUI_PUBLIC_URL=https://chat.example.com
OPENWEBUI_OIDC_CLIENT_ID=replace-with-openwebui-client-id
OPENWEBUI_OIDC_CLIENT_SECRET=replace-with-openwebui-client-secret
OPENWEBUI_API_KEY=replace-with-local-model-gateway-key

# --- Database ---------------------------------------------------------------
POSTGRES_USER=conductor
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=conductor

# --- Model gateway ----------------------------------------------------------
LLM_BASE_URL=http://local-model-gateway:4000/v1
LLM_MODEL_ALIAS=deepseek-flash

# --- Groups and features ----------------------------------------------------
OPERATOR_GROUPS=["cloudstack-conductor-operators"]
DOMAIN_ADMIN_GROUPS=["cloudstack-conductor-domain-admins"]
CONSOLE_ALLOWED_HOSTS=["console-proxy.example.com"]
CONSOLE_ALLOWED_PORTS=[443,8443]
GUEST_TASKS_ENABLED=false
CONDUCTOR_LOG_LEVEL=INFO

# --- Private paths ----------------------------------------------------------
CONDUCTOR_SECRETS_DIR=/srv/conductor/secrets
CONDUCTOR_BRANDING_DIR=/srv/conductor/branding

# Model repository or a locally mounted model path for the embedding worker.
CONDUCTOR_KNOWLEDGE__EMBEDDING_MODEL=BAAI/bge-m3
